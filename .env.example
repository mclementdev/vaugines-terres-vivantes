# ---------------------------------------------------------------------------
# vaugines, terres vivantes — variables d'environnement
# Copier en .env.local pour le développement. Ne jamais committer de secret.
# En local, les valeurs Supabase s'obtiennent avec : npx supabase status
# ---------------------------------------------------------------------------

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : serveur uniquement (écritures publiques validées, tâches planifiées)
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Variables ajoutées aux lots suivants -----------------------------------
# Resend (lot 4)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="vaugines, terres vivantes <bonjour@exemple.fr>"
# EMAIL_REPLY_TO=vauginesterresvivantes@gmail.com

# Tâches planifiées appelées par pg_cron (lot 4)
# CRON_SECRET=une-longue-chaine-aleatoire

# Anthropic, newsletter IA (lot 6) — serveur uniquement
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-5-5
